#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define Base 0
#define Nav  1
#define Num  2
#define Fun  3

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
        };

        comma_semi: comma_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_SEMICOLON";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        
        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        
        slash_qmark: slash_question {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&morph_qmark_excl>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        
        morph_qmark_excl: question_exclamation {
            compatible = "zmk,behavior-mod-morph";
            label = "QMARK_EXCL";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        magic_shift: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_SHIFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&shift_morph>;
        };
        
        shift_morph: shift_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_MORPH";
            #binding-cells = <0>;
            bindings = <&sk LSHIFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };

        smart_num: smart_num_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_NUM";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&num_dance>;
        };
        
        num_dance: num_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "NUM_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&num_word>, <&none>;
        };
        
        num_word: num_word {
            compatible = "zmk,behavior-caps-word";
            label = "NUM_WORD";
            #binding-cells = <0>;
            continue-list = <BACKSPACE DELETE DOT COMMA PLUS MINUS STAR FSLH EQUAL N0 N1 N2 N3 N4 N5 N6 N7 N8 N9 KP_N0 KP_N1 KP_N2 KP_N3 KP_N4 KP_N5 KP_N6 KP_N7 KP_N8 KP_N9>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_excl { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <0 10>; bindings = <&kp EXCL>; layers = <Base>; };
        combo_at { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <1 11>; bindings = <&kp AT>; layers = <Base>; };
        combo_hash { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <2 12>; bindings = <&kp HASH>; layers = <Base>; };
        combo_dollar { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <3 13>; bindings = <&kp DLLR>; layers = <Base>; };
        combo_percent { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <4 14>; bindings = <&kp PRCNT>; layers = <Base>; };
        combo_caret { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <5 15>; bindings = <&kp CARET>; layers = <Base>; };
        combo_ampersand { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <6 16>; bindings = <&kp AMPS>; layers = <Base>; };
        combo_star { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <7 17>; bindings = <&kp STAR>; layers = <Base>; };
        combo_lpar { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <8 18>; bindings = <&kp LPAR>; layers = <Base>; };
        combo_rpar { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <9 19>; bindings = <&kp RPAR>; layers = <Base>; };
        combo_grave { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <10 21>; bindings = <&kp GRAVE>; layers = <Base>; };
        combo_minus { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <11 22>; bindings = <&kp MINUS>; layers = <Base>; };
        combo_equal { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <12 23>; bindings = <&kp EQUAL>; layers = <Base>; };
        combo_lbkt { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <13 24>; bindings = <&kp LBKT>; layers = <Base>; };
        combo_rbkt { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <14 25>; bindings = <&kp RBKT>; layers = <Base>; };
        combo_bslh { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <15 26>; bindings = <&kp BSLH>; layers = <Base>; };
        combo_pipe { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <16 27>; bindings = <&kp PIPE>; layers = <Base>; };
        combo_under { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <17 28>; bindings = <&kp UNDER>; layers = <Base>; };
        combo_plus { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <18 29>; bindings = <&kp PLUS>; layers = <Base>; };
        combo_lbrc { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <3 4>; bindings = <&kp LBRC>; layers = <Base>; };
        combo_rbrc { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <5 6>; bindings = <&kp RBRC>; layers = <Base>; };
        combo_esc { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <0 1>; bindings = <&kp ESC>; layers = <Base>; };
        combo_tab { timeout-ms = <30>; require-prior-idle-ms = <150>; key-positions = <10 11>; bindings = <&kp TAB>; layers = <Base>; };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "Base";
            bindings = 
&kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
&hml LGUI A &hml LALT S &hml LCTRL D &hml LSHIFT F &kp G &kp H &hmr RSHIFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI
&lt Fun ESC &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &comma_semi &dot_colon &slash_qmark &kp APOSTROPHE
&trans &lt Nav SPACE &magic_shift LSHIFT 0 &smart_num Num 0 &lt Nav SPACE &trans
            >;
        };
        nav_layer {
            display-name = "Nav";
            bindings = 
&kp TILDE &trans &kp UP &trans &kp LBRC &kp RBRC &kp N7 &kp N8 &kp N9 &kp N0
&kp LSHIFT &kp LEFT &kp DOWN &kp RIGHT &kp LBKT &kp RBKT &kp N4 &kp N5 &kp N6 &kp MINUS
&kp LALT &kp LGUI &kp MINUS &trans &kp PLUS &kp LPAR &kp RPAR &kp N1 &kp N2 &kp N3 &kp KP_MULTIPLY &kp PLUS
&trans &trans &trans &trans &trans &kp DOT
            >;
        };
        num_layer {
            display-name = "Num";
            bindings = 
&trans &kp N7 &kp N8 &kp N9 &kp PLUS &trans &trans &trans &trans &trans
&kp N0 &kp N4 &kp N5 &kp N6 &kp MINUS &trans &trans &trans &trans &trans
&trans &kp N1 &kp N2 &kp N3 &kp STAR &kp FSLH &trans &trans &trans &trans &trans &trans
&kp DOT &kp EQUAL &trans &trans &trans &trans
            >;
        };
        fun_layer {
            display-name = "Fun";
            bindings = 
&bootloader &trans &trans &trans &trans &trans &kp F7 &kp F8 &kp F9 &kp F12
&bt BT_CLR &bt BT_PRV &bt BT_NXT &trans &trans &trans &kp F4 &kp F5 &kp F6 &kp F11
&trans &trans &trans &trans &trans &trans &trans &kp F1 &kp F2 &kp F3 &kp F10 &trans
&trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
